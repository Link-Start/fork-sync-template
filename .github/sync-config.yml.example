# Fork Sync 配置文件
#
# 复制本文件为 .github/sync-config.yml 放在你这个 config 仓库根目录
# 优先级: workflow input > sync-config.yml > yml 里的 env default
#
# 格式: 简单的 key: value (一行一个,值可用双引号/单引号/裸值)
# 不支持嵌套 YAML,不支持 list (需要 list 的用逗号分隔)

# 排除仓库名含这个 pattern 的 fork (大小写不敏感,匹配 fork 名称)
# 留空 = 不排除
exclude_pattern: "claude"

# 精确排除的 fork 名,逗号分隔
# 留空 = 不排除指定 fork
exclude_repos: ""

# 保护跳过列表,逗号分隔;支持 repo 或 owner/repo
# 命中后只创建/复用 fork 内 local-backup/* 保护备份,然后跳过同步和 Discard
protected_skip_repos: ""

# 集中默认分支备份列表,逗号分隔;支持 repo 或 owner/repo
# 命中后只把 fork 默认分支备份到 legacy_backup_repo,然后跳过同步和 Discard
legacy_backup_repos: ""

# 集中备份后同步列表,逗号分隔;支持 repo 或 owner/repo
# 命中后会先把 fork 默认分支备份到 legacy_backup_repo,校验成功后才允许原 fork 对齐当前指向库
backup_then_sync_repos: ""

# 集中备份仓库;backup_then_sync_repos 非空时必填,例如 Link-Start/fork-legacy-backups
legacy_backup_repo: ""

# 集中备份分支前缀,最终分支类似 legacy/repo_name
legacy_backup_branch_prefix: "legacy"

# 单独仓库全分支备份;开启后会在同步/Discard 前把每个 fork 的所有分支和 tag
# 备份到 mirror_backup_owner 下按 fork 仓库名命名的私有非 fork 仓库。
# 需要配置 secrets.BACKUP_GH_TOKEN;如果要自动建库,token 必须属于 mirror_backup_owner。
mirror_backup_enabled: "false"
mirror_backup_owner: "LinkStart413"
# 留空或 "*" = 备份所有本次发现的 fork;非空 = 只备份这些 repo 或 owner/repo
mirror_backup_repos: ""
mirror_backup_repo_prefix: ""
mirror_backup_repo_suffix: ""
mirror_backup_max_parallel: 1
mirror_backup_snapshot_prefix: "snapshots"
mirror_backup_current_prefix: "current"
mirror_backup_tag_prefix: "backup"
mirror_backup_update_current: "true"

# 只做独立仓库全分支备份,跳过后续同步/Discard。
# 适合把本模板作为灾备调度器使用。
backup_only: "false"

# 上游体积暴减告警阈值 (上游体积/fork 体积 < 此值触发,跳过 fork)
# 0.10 = 敏感 (推荐)  0.30 = 宽松  0 = 关闭
size_drop_threshold: 0.10

# 豁免 size 检查的 fork 名,逗号分隔 (适用于 1KB CLI 工具之类的小项目)
size_check_exempt: ""

# 最大并发 fork 数
# 4 推荐值(够快又不触发限流),8 激进,1 串行
max_parallel: 4

# 每个 fork 默认最多同步 upstream 分支数
# 6 = 默认分支优先 + 前 5 个其他 upstream 分支;0 = 不限制
max_branches_per_fork: 6

# 默认跳过的 upstream 分支 glob,逗号分隔
# 默认分支永远优先处理,不受这里影响
skip_branch_patterns: "backup/*,local-backup/*,sync-upstream/*,dependabot/*"

# 指定 fork 同步全部 upstream 分支,逗号分隔;支持 repo 或 owner/repo
# 示例: "repo-a,Link-Start/repo-b"
full_branch_sync_repos: ""

# 按分支数分组指定 fork,支持任意数量规格;支持 repo 或 owner/repo
# 格式: 分支数:仓库1,仓库2;分支数:仓库3,仓库4
# 示例: "3:fork1,fork2;4:fork3,Link-Start/fork4;100:fork5;0:fork6"
# 0 表示该组仓库不限制,同步全部 upstream 分支
branch_limit_groups: ""

# 任意 N 口子,格式 repo=12,owner/repo=20;值为 0 表示该 repo 不限制
# 优先级: full_branch_sync_repos > branch_limit_overrides > branch_limit_groups > max_branches_per_fork
branch_limit_overrides: ""

# 同步模式
# auto = 自动同步 (behind 走 merge-upstream,分歧按 discard_local_changes 处理)
# pr   = 落后时开 PR 让人审 (只对 behind 状态有效)
sync_mode: auto

# upstream 有新增且 fork 有本地提交时的处理方式
# force = 去重备份本地修改后,执行 GitHub Discard commits,强制对齐 upstream
# keep  = 去重备份本地修改后,尝试 merge-upstream 保留本地提交
# 纯 ahead 且 upstream 无新增时跳过,不备份也不写分支
discard_local_changes: force

# Webhook 类型: slack / dingtalk / generic
# 留空 = 不通知; URL 配在 secrets.WEBHOOK_URL 更安全
webhook_type: slack
